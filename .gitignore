# ==========================================
# Root .gitignore for SQLNest (SQLForge)
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
secrets.json

# Backend (Python / Django)
backend/venv/
backend/env/
backend/.venv/
**/__pycache__/
**/*.py[cod]
backend/db.sqlite3
backend/db.sqlite3-journal
backend/staticfiles/
backend/media/
backend/*.log

# Frontend (Node / Vite / React)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.eslintcache

# Logs
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
*~

